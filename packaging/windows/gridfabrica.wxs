<?xml version="1.0" encoding="utf-8"?>
<!--
  GridFabrica MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build gridfabrica.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut, App Paths (Win+R `gridfabrica`),
  and GridFabrica offered under "Open with" (and in Settings > Default apps) for .xlsx, .xlsm,
  .csv and .tsv, without taking over the user's default app for them.

  UpgradeCode is fixed for GridFabrica (generated 2026-10-07): never change it, or upgrades
  install side by side instead of replacing the old version.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="GridFabrica"
      Manufacturer="OpenFabrica"
      Version="$(var.Version)"
      UpgradeCode="5511327B-F305-41BE-92D0-EB84944E7C4D"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="GridFabrica spreadsheet" Manufacturer="OpenFabrica" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of GridFabrica is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="gridfabricaIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="gridfabricaIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/OpenFabrica/gridfabrica" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/OpenFabrica/gridfabrica" />
    <Property Id="ARPHELPLINK" Value="https://github.com/OpenFabrica/gridfabrica/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="GridFabrica" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="GridFabrica" Level="1">
      <ComponentGroupRef Id="gridfabricaFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="gridfabricaFiles" Directory="INSTALLFOLDER">
      <Component Id="gridfabricaApp" Guid="0507D4B6-12FF-4882-84E1-59083E74A4EB">
        <File Id="gridfabricaExe" Source="$(var.BinDir)\gridfabrica.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="GridFabrica"
              Description="GridFabrica spreadsheet" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="gridfabricaIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\gridfabrica.exe" Value="[#gridfabricaExe]" Type="string" />

        <!-- ProgIds: how Explorer opens a file with GridFabrica. Nothing here sets HKCR\.<ext>'s
             default value, so the user's current default app is left alone. -->
        <RegistryValue Root="HKLM" Key="Software\Classes\GridFabrica.Workbook" Value="GridFabrica Workbook" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\GridFabrica.Workbook\DefaultIcon" Value="&quot;[#gridfabricaExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\GridFabrica.Workbook\shell\open\command" Value="&quot;[#gridfabricaExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\GridFabrica.TextData" Value="GridFabrica Text Data" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\GridFabrica.TextData\DefaultIcon" Value="&quot;[#gridfabricaExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\GridFabrica.TextData\shell\open\command" Value="&quot;[#gridfabricaExe]&quot; &quot;%1&quot;" Type="string" />

        <!-- "Open with": Windows reads only the value names under OpenWithProgids; the data is
             ignored (WiX rejects an empty Value, so it repeats the ProgId). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\.xlsx\OpenWithProgids" Name="GridFabrica.Workbook" Value="GridFabrica.Workbook" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.xlsm\OpenWithProgids" Name="GridFabrica.Workbook" Value="GridFabrica.Workbook" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.csv\OpenWithProgids" Name="GridFabrica.TextData" Value="GridFabrica.TextData" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.tsv\OpenWithProgids" Name="GridFabrica.TextData" Value="GridFabrica.TextData" Type="string" />

        <!-- Settings > Default apps: lets the user pick GridFabrica for these types. -->
        <RegistryValue Root="HKLM" Key="Software\GridFabrica\Capabilities" Name="ApplicationName" Value="GridFabrica" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\GridFabrica\Capabilities" Name="ApplicationDescription" Value="Open-source spreadsheet for .xlsx, CSV and TSV files" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\GridFabrica\Capabilities\FileAssociations" Name=".xlsx" Value="GridFabrica.Workbook" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\GridFabrica\Capabilities\FileAssociations" Name=".xlsm" Value="GridFabrica.Workbook" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\GridFabrica\Capabilities\FileAssociations" Name=".csv" Value="GridFabrica.TextData" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\GridFabrica\Capabilities\FileAssociations" Name=".tsv" Value="GridFabrica.TextData" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Name="GridFabrica" Value="Software\GridFabrica\Capabilities" Type="string" />
      </Component>

      <Component Id="gridfabricaCli">
        <File Id="gridfabricaCliExe" Source="$(var.BinDir)\gridfabrica-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
